{
  "name": "techrush-project-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix TechRush-Project/backend && npm install --prefix TechRush-Project/frontend",
    "dev:backend": "npm run dev --prefix TechRush-Project/backend",
    "dev:frontend": "npm run dev --prefix TechRush-Project/frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
